# Copy to infra/.env.demo on the VPS (never commit the real file).
# Generate SECRET_KEY with:   openssl rand -base64 48
# Generate POSTGRES_PASSWORD with: openssl rand -hex 24
SECRET_KEY=changeme
POSTGRES_PASSWORD=changeme

# RSA_PRIVATE_KEY is required once DEBUG=False (JWT signing). Generate with:
#   openssl genrsa -out /tmp/saleor-rsa.pem 2048
# then append it correctly (preserving real newlines) with:
#   echo "RSA_PRIVATE_KEY=\"$(cat /tmp/saleor-rsa.pem)\"" >> infra/.env.demo
#   rm /tmp/saleor-rsa.pem
# Do NOT hand-type this value on one line — it must keep its PEM line breaks.
RSA_PRIVATE_KEY=changeme
